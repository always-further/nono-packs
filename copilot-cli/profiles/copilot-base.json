{
  "extends": "default",
  "meta": {
    "name": "copilot-cli-base",
    "description": "Base profile for sandboxed GitHub Copilot CLI sessions. Extended by copilot-cli and copilot-cli-proxy.",
    "author": "always-further"
  },
  "workdir": {
    "access": "readwrite"
  },
  "groups": {
    "include": [
      "rust_runtime",
      "git_config"
    ]
  },
  "filesystem": {
    "allow": [
      { "path": "/usr/local/Caskroom/copilot-cli", "when": "macos" },
      { "path": "/usr/local/bin/copilot", "when": "linux" },
      { "path": "/usr/bin/copilot", "when": "linux" },
      { "path": "/home/linuxbrew/.linuxbrew/bin/copilot", "when": "linux" },
      "$HOME/.copilot",
      { "path": "$HOME/Library/Caches/copilot", "when": "macos" },
      { "path": "$HOME/.cache/copilot", "when": "linux" }
    ],
    "read": [
      "$HOME/.config/gh",
      "$HOME/.agents/skills"
    ],
    "read_file": [
      {
        "path": "$HOME/Library/Application Support/Code/User/keybindings.json",
        "when": "macos"
      },
      {
        "path": "$HOME/.config/Code/User/keybindings.json",
        "when": "linux"
      },
      {
        "path": "$HOME/Library/Application Support/Microsoft/DeveloperTools/deviceid",
        "when": "macos"
      },
      {
        "path": "$HOME/.config/Microsoft/DeveloperTools/deviceid",
        "when": "linux"
      }
    ]
  },
  "open_urls": {
    "allow_origins": ["https://github.com"],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "unsafe_macos_seatbelt_rules": [
    "(allow user-preference-read)"
  ]
}
